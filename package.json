{
  "name": "newfirst-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy-pyodide": "node scripts/copy-pyodide.mjs",
    "dev": "npm run copy-pyodide && vite --host",
    "build": "npm run copy-pyodide && vite build",
    "preview": "vite preview --host",
    "test": "node tests/step1.test.mjs && node tests/step2.test.mjs && node tests/step3.test.mjs && node tests/step4.test.mjs && node tests/step8-u3.test.mjs && node tests/step6.test.mjs && node tests/step7.test.mjs && node tests/a11y-sheet.test.mjs && node tests/judge.test.mjs && npm run copy-pyodide && node tests/judge-browser.test.mjs",
    "test:setup": "playwright install chromium",
    "test:judge-browser": "npm run copy-pyodide && node tests/judge-browser.test.mjs",
    "test:mobile": "node tests/webkit/run.mjs",
    "verify:content": "python3 scripts/verify-content.py"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "playwright": "1.63.0"
  }
}
