{
  "name": "newfirst-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy-pyodide": "node scripts/copy-pyodide.mjs",
    "dev": "npm run copy-pyodide && vite --host",
    "build": "npm run copy-pyodide && vite build",
    "preview": "vite preview --host",
    "test": "node scripts/run-tests.mjs",
    "test:chain": "node tests/sw-update-safe.test.mjs",
    "test:setup": "playwright install chromium",
    "test:judge-browser": "npm run copy-pyodide && node tests/judge-browser.test.mjs",
    "test:mobile": "node tests/webkit/run.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:preview-build": "node tests/preview-build-isolation.test.mjs",
    "verify:content": "python3 scripts/verify-content.py",
    "test:hardening": "node tests/login-sync-hardening.test.mjs && node tests/sync-mutation.test.mjs && node tests/pending-import-corrupt-guard.test.mjs && node tests/r1-exit-interaction.test.mjs && node tests/r1-logout-integration.test.mjs && node --test tests/local-writeback-retry-limit.test.mjs && node --test tests/gpt1-003-r1-exit-integration.test.mjs && node --test tests/pending-import-quarantine.test.mjs && node --test tests/auth-cleanup-race.test.mjs && node --test tests/preview-cloud-check.test.mjs",
    "test:edges": "node tests/cloud-sync-edges.test.mjs && node tests/data-compat-edges.test.mjs",
    "test:db": "bash supabase/tests/run-all.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "playwright": "1.63.0"
  }
}
